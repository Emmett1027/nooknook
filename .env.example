# Supabase connection.
# Verified against the installed @supabase/ssr / @supabase/supabase-js clients:
# these clients do not read env vars themselves, so we expose the project URL and
# publishable (anon) key to the browser using the required NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# New-style publishable key (sb_publishable_...). The legacy anon key
# (NEXT_PUBLIC_SUPABASE_ANON_KEY) is also supported as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
